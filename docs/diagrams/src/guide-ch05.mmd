        R3 --> R4{"ต้องการส่งไหม?"}
        R4 -- "ใช่" --> R5["bpf_ringbuf_submit()"]
        R4 -- "ไม่" --> R6["bpf_ringbuf_discard()"]
        R5 --> BUF[("RINGBUF ก้อนเดียว<br/>ทุก CPU แชร์ · global order")]
    end

    subgraph LSM["5.4 BPF LSM: บล็อกที่จุดเกิดเหตุ"]

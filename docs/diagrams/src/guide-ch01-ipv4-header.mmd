packet-beta
    title IPv4 HEADER STRUCTURE (1 แถว = 4 ไบต์: Byte 0-3, 4-7, 8-11, 12-15, 16-19)
    0-3: "Version"
    4-7: "IHL"
    8-15: "Type of Service"
    16-31: "Total Length"
    32-47: "Identification"
    48-50: "Flags"
    51-63: "Fragment Offset"
    64-71: "Time to Live"
    72-79: "Protocol"
    80-95: "Header Checksum"
    96-127: "Source Address"
    128-159: "Destination Address"
    160-183: "Options (Byte 20 - 59, Optional)"
    184-191: "Padding"

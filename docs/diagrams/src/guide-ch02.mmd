flowchart TD
    subgraph BUILD["2.2 Build Pipeline"]
        C1["my_prog.bpf.c"] --> C2["clang -target bpf -O2 -g"]
        C2 --> C3[("ELF .o<br/>.text bytecode · .maps · .BTF")]
    end

    subgraph LOAD["User Space Loader: cilium/ebpf หรือ libbpf"]

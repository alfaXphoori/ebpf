flowchart TD
    subgraph RX["PACKET INGRESS (RX PATH)"]
        NRX["NIC Driver RX Buffer"] --> XDP["eBPF XDP HOOK<br/>(ctx: struct xdp_md, Wire-Speed)"]
        XDP -- "XDP_DROP" --> DROP["ทำลายทิ้งทันที"]
        XDP -- "XDP_PASS" --> SKB["Allocate struct sk_buff"]
        XDP -- "XDP_TX" --> HP["สะท้อนแพ็กเก็ตกลับสายแลน<br/>Hairpin Out"]
        SKB --> TCI["TC Ingress Hook (clsact)"]
        TCI --> STK["Linux TCP/IP Stack & Routing"]
    end

    subgraph TX["PACKET EGRESS (TX PATH)"]
        TCE["TC Egress Hook (clsact)<br/>(ctx: struct __sk_buff, QoS & Marking)"] --> NTX["NIC Driver TX Buffer (Wire)"]
    end

    STK --> TCE

    classDef kern fill:#ffe4e6,stroke:#e11d48,stroke-width:2px,color:#0f172a

flowchart LR
    subgraph NET["① Network Wire (Big-Endian)"]
        A0["Address[0] = 0x00"]
        A1["Address[1] = 0x50"]
    end
    subgraph CPU["② CPU อ่านตรงๆ (Little-Endian)"]
        L["LSB = 0x00"]
        M["MSB = 0x50"]
    end
    R["③ คำนวณเป็นค่าตัวเลข<br/>(0x50 #lt;#lt; 8) | 0x00 = 0x5000<br/>= 20,480 ในฐานสิบ !!"]

    A0 --> L
    A1 --> M
    L --> R
    M --> R

    classDef kern fill:#ffe4e6,stroke:#e11d48,stroke-width:2px,color:#0f172a
    classDef net fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#0f172a
    class A0,A1 net
    class L,M,R kern
